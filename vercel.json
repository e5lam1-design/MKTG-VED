{
  "name": "marketing-dashboard-v1",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/reels/update", "destination": "/api/reels-update" },
    { "source": "/api/tagme3at/:key", "destination": "/api/tagme3at?key=:key" },
    { "source": "/api/users/:id", "destination": "/api/users?id=:id" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
